# Copia este archivo como .env y completa los valores. El .env NUNCA se sube a GitHub.

# Base de datos: RDS PostgreSQL (veterinaria-db)
DB_HOST=veterinaria-db.cskwlxagaj2k.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=veterinaria
# El usuario maestro que pusiste al crear la RDS
DB_USER=postgres
DB_PASSWORD=
# require = conexión cifrada (RDS). Para el postgres local de docker-compose usa disable.
DB_SSLMODE=require

# JWT: el MISMO secreto en los dos servicios, de al menos 32 caracteres.
# Puedes generar uno con: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=veterinaria-san-marcos
JWT_AUDIENCE=veterinaria-frontend
JWT_EXP_MIN=60

# Primer administrador: se crea al arrancar auth-service si no existe
ADMIN_EMAIL=admin@veterinaria.cl
ADMIN_PASSWORD=

# Orígenes del frontend que pueden leer las respuestas (separados por coma)
CORS_ORIGINS=http://localhost:5173
